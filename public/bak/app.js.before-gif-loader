  for (const key of ['mods', 'shaderpacks', 'resourcepacks']) {
    const items = data[key] ?? [];
    if (!items.length) continue;
    groups.push(`
      <div>
        <div class="group-title">${GROUP_LABEL[key]}（${items.length}）</div>
        ${items.map((f) => `
          <div class="file-row ${f.disabled ? 'off' : ''}">
