/** 512M / 4G -> MB */
function memToMb(s) {
  const v = String(s ?? '').trim().toUpperCase();
  const n = Number(v.slice(0, -1));
  if (!Number.isFinite(n)) return 0;
  return v.endsWith('G') ? n * 1024 : n;
}

