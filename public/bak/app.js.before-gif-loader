function connectEvents() {
  const es = new EventSource('/api/events');

  es.onmessage = (ev) => {
    let msg;
    try { msg = JSON.parse(ev.data); } catch { return; }

    switch (msg.type) {
      case 'hello': {
        const s = msg.state || {};
        state.installing = s.installing;
        state.running = s.running;
        refreshStatus();
        if (s.installing) {
          showProgress(true);
          updateProgress(s.installing);
        }
        break;
      }

      case 'install-start':
        state.installing = { versionId: msg.versionId, stage: 'start' };
        resetCancelButton();
        showProgress(true);
        updateProgress({ stage: 'start', message: `开始安装 ${msg.versionId}` });
        refreshStatus();
        break;

      case 'install-stage':
        updateProgress({ stage: msg.stage, message: msg.message });
        break;

      case 'install-progress':
        updateProgress(msg);
        break;

      case 'install-done': {
        const st = msg.report?.stages || {};
        const libs = st.libraries || {};
        const assets = st.assets || {};
        const jv = st.java || {};
        let detail = `库 ${libs.downloaded ?? 0} 个，资源 ${assets.downloaded ?? 0} 个`;
        if (jv.installed) detail += `，顺带装了 Java ${jv.required}`;
        updateProgress({ stage: 'done', message: `安装完成：${detail}` });
        $('progressFill').style.width = '100%';
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 3000);
        loadInstalled();
        loadRemote();
        break;
      }

      case 'install-error':
        updateProgress({ stage: 'error', message: `安装失败：${msg.error}` });
        $('progressFill').style.width = '0%';
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 5000);
        break;

      // 取消成功：不是失败，别报红。
      // 进度条直接收掉，并告诉人“已下好的文件留着”。
      case 'install-cancelled':
        updateProgress({ stage: 'error', message: cancelText(msg.message) });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 1800);
        break;

      /* ---- 内容 ---- */
      case 'content-start':
        state.installing = { versionId: msg.versionId };
        resetCancelButton();
        showProgress(true);
        updateProgress({ stage: 'content', message: `安装 ${msg.count} 个文件…` });
        refreshStatus();
        break;

      case 'content-progress':
        updateProgress(msg);
        break;

      case 'content-done': {
        const r = msg.result || {};
        updateProgress({
          stage: 'done',
          message: `完成：新装 ${r.installed?.length ?? 0}，已有 ${r.skipped?.length ?? 0}，失败 ${r.failed?.length ?? 0}`,
        });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 2500);
        if (state.contentVersion) openContent(state.contentVersion);
        break;
      }

      case 'content-error':
        updateProgress({ stage: 'error', message: `安装失败：${msg.error}` });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 5000);
        break;

      case 'content-cancelled':
        updateProgress({ stage: 'error', message: cancelText(msg.message) });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 1800);
        break;

      /* ---- 模组批量更新 ---- */
      case 'mods-update-start':
        state.installing = { versionId: msg.versionId };
        resetCancelButton();
        showProgress(true);
        updateProgress({ stage: 'mod-update', message: `开始更新 ${msg.count} 个模组…` });
        refreshStatus();
        break;

      case 'mods-update-progress':
        updateProgress({ stage: 'mod-update', done: msg.done, total: msg.total, message: msg.message });
        break;

      case 'mods-update-done': {
        const r = msg.result || {};
        const failed = r.failed?.length ?? 0;
        updateProgress({
          stage: failed ? 'error' : 'done',
          message: `更新完成：成功 ${r.updated?.length ?? 0}，失败 ${failed}`,
        });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), failed ? 5000 : 2500);
        // 更新完重新扫一遍：从列表里去掉已更新的，显示真实结果
        if (state.contentVersion) {
          openContent(state.contentVersion);
          setTimeout(() => { if (state.contentVersion) checkModUpdates(); }, 600);
        }
        break;
      }

      case 'mods-update-error':
        updateProgress({ stage: 'error', message: `模组更新失败：${msg.error}` });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 5000);
        break;

      case 'mods-update-cancelled':
        updateProgress({ stage: 'error', message: cancelText(msg.message) });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 1800);
        if (state.contentVersion) openContent(state.contentVersion);
        break;

      /* ---- Fabric ---- */
      case 'fabric-start':
        state.installing = { versionId: msg.gameVersion };
        resetCancelButton();
        showProgress(true);
        updateProgress({ stage: 'fabric', message: '开始安装 Fabric…' });
        refreshStatus();
        break;

      case 'fabric-stage':
        updateProgress({ stage: msg.stage, message: msg.message });
        break;

      case 'fabric-progress':
        updateProgress(msg);
        break;

      case 'fabric-done':
        updateProgress({ stage: 'done', message: `Fabric 完成：${msg.result?.versionId}` });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 2500);
        loadInstalled();
        break;

      case 'fabric-error':
        updateProgress({ stage: 'error', message: `Fabric 失败：${msg.error}` });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 5000);
        break;

      case 'fabric-cancelled':
        updateProgress({ stage: 'error', message: cancelText(msg.message) });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 1800);
        break;

      /* ---- 整合包 ---- */
      case 'modpack-start':
        state.installing = { versionId: 'modpack' };
        resetCancelButton();
        showProgress(true);
        updateProgress({ stage: 'modpack', message: '开始安装整合包…' });
        refreshStatus();
        break;

      case 'modpack-stage':
        updateProgress({ stage: msg.stage, message: msg.message });
        break;

      case 'modpack-progress':
        updateProgress(msg);
        break;

      case 'modpack-done': {
        const r = msg.result || {};
        updateProgress({
          stage: 'done',
          message: `整合包完成：${r.instanceId}（${r.files?.downloaded ?? 0} 个文件）`,
        });
        $('progressFill').style.width = '100%';
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 3500);
        loadInstalled();
        break;
      }

      case 'modpack-error':
        updateProgress({ stage: 'error', message: `整合包失败：${msg.error}` });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 5000);
        break;

      case 'modpack-cancelled':
        updateProgress({ stage: 'error', message: cancelText(msg.message) });
        state.installing = null;
        disableCancelButton();
        refreshStatus();
        setTimeout(() => showProgress(false), 1800);
        break;

      /* ---- 游戏 ---- */
      case 'game-start':
        state.running = { versionId: msg.versionId, pid: msg.pid };
        refreshStatus();
        renderInstalled();
        break;

      case 'game-exit':
        state.running = null;
        refreshStatus();
        renderInstalled();
        appendLog(`<<< 游戏退出 code=${msg.code}`);
        break;

      case 'log':
        appendLog(msg.line);
        break;

      case 'track-update': {
        // 后台轮询发现新版本：本地列表立刻刷新，不用等用户手点
        const found = msg.found ?? [];
        if (found.length) {
          for (const f of found) {
            appendLog(`发现新版本：${f.title} ${f.from ?? '?'} → ${f.to}`);
          }
          loadTrack();
        }
        break;
      }
    }
  };

  es.onerror = () => {
    setStatus('idle', '连接断开，重连中…');
  };
}

